{
  "name": "buron-digital/deserializing-connection",
  "description": "Get DTOs directly from the database",
  "type": "symfony-bundle",
  "require": {
    "php": "8.5.*|8.6.*",
    "buron-digital/self-aware-normalizers": "^2.0.0",
    "doctrine/dbal": "^4.5",
    "doctrine/sql-formatter": "^1.5",
    "symfony/framework-bundle": "^7.4|^8.0",
    "symfony/serializer": "^7.4|^8.0"
  },
  "require-dev": {
    "buron-digital/ids": "^3.0.0",
    "doctrine/orm": "^3.7",
    "friendsofphp/php-cs-fixer": "^3.95",
    "infection/infection": "^0.35",
    "phpunit/phpunit": "^13.4",
    "symfony/property-access": "^7.4|^8.0",
    "symfony/property-info": "^7.4|^8.0",
    "vimeo/psalm": "^6.20"
  },
  "suggest": {
    "doctrine/orm": "Required to get managed entities from native SQL through the ResultSetMappingConnection"
  },
  "autoload": {
    "psr-4": {
      "BuronDigital\\DeserializingConnection\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BuronDigital\\DeserializingConnection\\": "tests/"
    }
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Christian Kolb",
      "email": "info@buron.digital"
    }
  ],
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "infection/extension-installer": true
    }
  }
}
